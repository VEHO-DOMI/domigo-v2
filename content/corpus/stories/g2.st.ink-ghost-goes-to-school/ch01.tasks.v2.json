 "scenes": [
  {
   "id": "vorfall",
   "lines": [
    {
     "speaker": null,
     "de": "Erster Schultag. Am Stundenplan an der Wand steht bei Montag nur noch „maths, maths, maths, maths“."
    },
    {
     "speaker": null,
     "de": "Darunter ist ein Gekritzel. Es sieht aus wie Merles Schrift."
    },
    {
     "speaker": "Frau Berger",
     "en": "Somebody wrote on our timetable. Merle, was it you?"
    },
    {
     "speaker": "Fenn",
     "en": "Is that your writing, Merle?"
    },
    {
     "speaker": null,
     "de": "Alle schauen Merle an. Merle wird rot."
    },
    {
     "speaker": "Klecks",
     "de": "Pssst, das ist Tinte! Nur du siehst sie leuchten."
    }
   ]
  },
  {
   "id": "bilanz",
   "counters": {
    "spuren": "4/4",
    "freundeEntlastet": "1/15",
    "zettel": 1
   },
   "lines": [
    {
     "speaker": null,
     "de": "Merle ist nicht mehr verdächtig. Sie geht jetzt mit dir."
    },
    {
     "speaker": null,
     "de": "Den Zettel von der Tür legst du ins Regelbuch. Vierzehn Freunde warten noch."
    }
   ]
  }
 ],
