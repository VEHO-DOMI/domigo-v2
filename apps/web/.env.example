# DomiGo v2 web app. Copy to .env.local (gitignored). Never commit real values.
# Prod DATABASE_URL + AUTH_SECRET are set in Vercel env (runbook-gated), never here.

# Dev Neon branch (HTTP pooler URL). The v2 tables live in the `domigo_v2` schema;
# v1's `public` is read for auth identity but never written.
DATABASE_URL=

# NextAuth v5. Generate a dev secret with: openssl rand -base64 33
AUTH_SECRET=
AUTH_URL=http://localhost:3013

# Dev identity fallback (non-prod only) for CI + verification scripts — a REAL
# migrated student + their class. Ignored entirely when VERCEL_ENV=production.
DEV_USER_ID=
DEV_CLASS_ID=

# P3 · Grandmaster rank (the platform operator). Comma-separated list of TEACHER
# ACCOUNT IDS that get the all-classes view (/admin/grandmaster) plus roster and
# assignment-builder access to EVERY class. Empty or unset ⇒ nobody has the rank.
# Deliberately an env var, not a database column: no application write path can
# reach it, so no bug and no compromised endpoint can hand the rank out. A teacher
# reads their own account id at /admin/settings. On production this is set in the
# Vercel env and only takes effect after a redeploy.
GRANDMASTER_TEACHER_IDS=

# P2 · Gemeinsamer Lehrer-Einladungs-Link. Wer die Adresse /lehrkraft/<WERT> öffnet,
# sieht die vorangelegten, noch leeren Klassen und kann eine davon übernehmen. EIN
# Wert für alle Kolleginnen; leer oder ungesetzt ⇒ die Route antwortet wie eine
# unbekannte Seite (fail closed). Widerruf = Wert ändern und neu ausrollen; ein
# Ablaufdatum gibt es bewusst nicht. Auf der Produktion in den Vercel-Variablen
# gesetzt und erst nach einem Redeploy wirksam.
TEACHER_INVITE_TOKEN=

# K2a · Der Wiedereinstiegs-Weg für Lehrkräfte (»PIN vergessen«). Versand über Brevo
# per fetch — keine zusätzliche Abhängigkeit. Brevo, weil eine EINZELN verifizierte
# Absenderadresse genügt: eine gewöhnliche Mailadresse reicht, es braucht keine
# eigene Domain. Fehlt BREVO_API_KEY oder MAIL_FROM_ADDRESS, wird nichts verschickt
# und die Seite /lehrkraft/pin-vergessen sagt das ehrlich; der Rückfallweg bleibt die
# Übergangs-PIN aus dem Großmeister-Bereich. Der Schlüssel ist ein GEHEIMNIS und steht
# nur in den Vercel-Variablen — hier niemals ein echter Wert.
# Auf der Produktion in den Vercel-Variablen gesetzt und erst nach einem Redeploy wirksam.
BREVO_API_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# Nur für die Entwicklung: MAIL_TRANSPORT=console schreibt die Mail samt Link ins
# Server-Protokoll, statt sie zu verschicken. Das ist die EINZIGE Möglichkeit, den
# Weg ohne Brevo-Konto durchzuspielen — der Wiederherstellungs-Link steht nirgendwo
# sonst, weil von ihm nur der Hash gespeichert wird. Auf der Produktion ist die
# Variable wirkungslos (Sperre auf VERCEL_ENV), damit ein Link nie in einem Protokoll
# landen kann. Leer lassen heißt: normaler Versand.
MAIL_TRANSPORT=
