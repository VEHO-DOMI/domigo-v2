# DomiGo v2 web app. Copy to .env.local (gitignored). Never commit real values.
# Prod DATABASE_URL + AUTH_SECRET are set in Vercel env (runbook-gated), never here.

# Dev Neon branch (HTTP pooler URL). The v2 tables live in the `domigo_v2` schema;
# v1's `public` is read for auth identity but never written.
DATABASE_URL=

# NextAuth v5. Generate a dev secret with: openssl rand -base64 33
AUTH_SECRET=
AUTH_URL=http://localhost:3013

# Dev identity fallback (non-prod only) for CI + verification scripts — a REAL
# migrated student + their class. Ignored entirely when VERCEL_ENV=production.
DEV_USER_ID=
DEV_CLASS_ID=

# P3 · Grandmaster rank (the platform operator). Comma-separated list of TEACHER
# ACCOUNT IDS that get the all-classes view (/admin/grandmaster) plus roster and
# assignment-builder access to EVERY class. Empty or unset ⇒ nobody has the rank.
# Deliberately an env var, not a database column: no application write path can
# reach it, so no bug and no compromised endpoint can hand the rank out. A teacher
# reads their own account id at /admin/settings. On production this is set in the
# Vercel env and only takes effect after a redeploy.
GRANDMASTER_TEACHER_IDS=

# dach-108 · TEACHER_INVITE_TOKEN, BREVO_API_KEY, MAIL_FROM_ADDRESS, MAIL_FROM_NAME und
# MAIL_TRANSPORT gibt es nicht mehr: Einladung und »PIN vergessen« liefen über DomiGos
# eigene PIN-Anmeldung, die seit Kokis Entscheid vom 19.09. entfernt ist. Angemeldet
# wird nur über das Konto bei Lauter Einser. Auf Vercel gesetzte Werte liest niemand mehr.

# K2b · Die Test-Bahn (»ops«). EIN Token schaltet den ganzen Namensraum
# /api/ops/… ein: ohne Wert existiert die Fläche nicht (fail closed), und unter
# 24 Zeichen wird sie ebenfalls verweigert — ein schwaches Geheimnis, das
# FUNKTIONIERT, wäre schlimmer als gar keins, weil es bewacht aussieht.
#
# ⚠ Das ist ein CREDENTIAL, kein Schalter. Es signiert auch jeden Einmal-
# Anmelde-Link, also kann sich damit jemand als jedes Kind der Ops-Klasse
# anmelden. Deshalb: hier NIE ein echter Wert (scripts/check-secrets.mjs prüft
# genau das), Prod-Wert nur in den Vercel-Variablen. Wert drehen = jeder
# ausstehende Link stirbt sofort mit, das ist der Widerrufs-Weg.
# Erzeugen: openssl rand -hex 24
DOMIGO_OPS_TOKEN=

# Die EINE Klasse, die die Test-Bahn anfassen darf — als Einladungscode. Alles
# außerhalb ist per WHERE-Klausel unerreichbar, nicht bloß ungefiltert: die
# gültige Kennung eines echten Kindes antwortet mit 404. Leer ⇒ Standard
# `75YAHV` (die stehende Prod-Test-Klasse TEST P). In der Entwicklung zeigt der
# Wert auf eine Dev-Klasse, z. B. TST2ER.
OPS_CLASS_CODE=

# ── dach-018 · Anmeldung ueber den Konto-Dienst ──────────────────────────────
# Die Adresse des Konto-Dienstes. Leer ⇒ die Adresse aus app/le-werkzeuge.json
# (die EINE Stelle, an der Werkzeug-Adressen stehen duerfen — das Tor
# check-umbrella-tokens haelt das fest). Lokal zeigt sie auf den Stub oder auf
# `npm run dev:lokal` des konto-Repos, also http://localhost:3100.
KONTO_BASE_URL=

# Das Geheimnis, mit dem sich DomiGo beim Konto-Dienst ausweist — derselbe Wert
# wie dort KONTO_APP_SECRET_GO, mindestens 24 Zeichen. Ohne ihn meldet sich
# niemand an: fail closed wie DOMIGO_OPS_TOKEN, und aus demselben Grund steht
# hier NIE ein echter Wert (scripts/check-secrets.mjs prueft genau das).
KONTO_APP_SECRET=

# Der Schluessel, mit dem Vercel den Nacht-Abgleich ruft (GET
# /api/cron/konto-sync, zwei Zeilen in vercel.json fuer Sommer- und Winterzeit;
# der Handler laeuft nur zur Wiener Stunde 3). Ebenfalls mindestens 24 Zeichen.
CRON_SECRET=
